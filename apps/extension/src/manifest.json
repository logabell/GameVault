{
  "manifest_version": 3,
  "name": "GameVault",
  "version": "1.0.0",
  "description": "Add supported game pages to GameVault and monitor library status.",
  "icons": {
    "16": "icons/gamevault-16.png",
    "32": "icons/gamevault-32.png",
    "48": "icons/gamevault-48.png",
    "128": "icons/gamevault-128.png"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://ankergames.net/*",
    "https://www.ankergames.net/*",
    "https://elamigos.site/*",
    "https://www.elamigos.site/*",
    "https://steamdb.info/*",
    "https://steamrip.com/*",
    "https://www.steamrip.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/gamevault-16.png",
      "32": "icons/gamevault-32.png",
      "48": "icons/gamevault-48.png",
      "128": "icons/gamevault-128.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js",
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gamevault@vaulttrack.local",
      "strict_min_version": "128.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://ankergames.net/game/*",
        "https://www.ankergames.net/game/*",
        "https://elamigos.site/data/*.html",
        "https://www.elamigos.site/data/*.html",
        "https://steamrip.com/*-free-download*",
        "https://www.steamrip.com/*-free-download*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://steamdb.info/app/*/patchnotes/*"],
      "js": ["steamdb-content.js"],
      "run_at": "document_idle"
    }
  ]
}
